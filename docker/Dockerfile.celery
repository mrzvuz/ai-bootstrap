FROM python:3.13.13-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN groupadd -r celery && useradd -r -g celery celery

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /workspace

COPY pyproject.toml uv.lock ./
COPY app/ ./app/

RUN uv pip install --system -e .
RUN uv pip install --system watchdog

RUN chown -R celery:celery /workspace

USER celery

CMD ["sh", "-c", "watchmedo auto-restart --directory=/workspace/app --pattern='*.py' --recursive -- celery -A launchpad.worker.config worker --loglevel=info --concurrency=1"]
